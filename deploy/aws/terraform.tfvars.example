# Copy to terraform.tfvars and adjust before running `terraform apply`.

project_name       = "ledgerx"
environment        = "production"
aws_region         = "us-east-1"
vpc_cidr           = "10.20.0.0/16"
kubernetes_version = "1.31"
node_instance_type = "t3.medium"
node_desired_size  = 2
node_min_size      = 1
node_max_size      = 4

tags = {
  Owner = "platform-team"
}
