# Copy to terraform.tfvars and adjust before running `terraform apply`.

project_id        = "my-gcp-project-id"
project_name      = "ledgerx"
environment       = "production"
region            = "us-central1"
subnet_cidr       = "10.40.0.0/20"
pods_cidr         = "10.41.0.0/16"
services_cidr     = "10.42.0.0/20"
node_machine_type = "e2-standard-2"
node_desired_size = 2
node_min_size     = 1
node_max_size     = 4

labels = {
  owner = "platform-team"
}
